# Ignore everything (else) by default
*
!.gitignore

# keep Verilog files (not .v.bak files), Quartus project file, and its settings
!*.v
*.bak
!*.qsf
!*.qpf

# keep important folders
!glyphs/
!glyphs/**
glyphs/*.exe
!src/
!src/**
!tb/
!tb/**
!docs/
!docs/**
!common/
!common/**
checkpoint1_color/
checkpoint1_color/**
checkpoint2_turn_signal/
checkpoint2_turn_signal/**
checkpoint3_mario/
checkpoint3_mario/**

# keep .csv files
!*.csv

# Allow Git to search one folder/directory down to look for additional files
!*/

# Keep the README
!README.md
