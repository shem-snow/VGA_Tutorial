# Ignore everything by default
*

# Allow Git to look inside folders (files in them are still filtered below)
!*/

# Project files
!.gitignore
!README.md
!*.qpf
!*.qsf

# Source and data folders: keep everything inside, at any depth
!src/**
!tb/**
!glyphs/**
!docs/**

# Exceptions: never keep these, even inside the folders above
*.bak
glyphs/*.exe